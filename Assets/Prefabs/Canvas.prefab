    - target: {fileID: 2598190784946733799, guid: 34b22358c0e1f654294c3e192a11bbe2, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: " \u521D\u6B21\u89C1\u9762\uFF0C\u6211\u5148\u81EA\u6211\u4ECB\u7ECD"
